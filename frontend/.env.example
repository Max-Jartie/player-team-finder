# Вариант с одним внешним портом 5173.
# Браузер обращается к фронтенду: http://176.108.254.224:5173
# API идёт через тот же порт: http://176.108.254.224:5173/api/v1
VITE_API_URL=/api/v1

# Внутренний адрес backend для Vite dev proxy и frontend/server.mjs.
# Этот адрес не должен быть доступен снаружи.
INTERNAL_API_URL=http://127.0.0.1:8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
